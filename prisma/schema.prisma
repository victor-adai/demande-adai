generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// status: submitted | adjusted | accepted | rejected
model Demande {
  id          String    @id @default(cuid())
  publicToken String    @unique @default(cuid())
  status      String    @default("submitted")

  currentPack     String
  selectedModules String // JSON string[]

  client    String // JSON ClientProfile
  need      String // JSON NeedProfile
  pricing   String // JSON PricingParams
  roiAdai   String // JSON RoiAdaiParams — confidential, never sent to the public offer
  roiClient String // JSON RoiClientParams

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Offer integrity snapshot: sanitized public-offer JSON frozen at publish time.
  // Never recomputed afterwards — a later catalog/engine change must not alter an
  // already-published client offer. Null until first publish (or for legacy rows,
  // backfilled once on first read — see getPublishedOfferByToken).
  publishedOffer String?

  @@index([status])
}

// Editable commercial catalogue (V1 scope: label, BUILD price, maintenance, active flag).
// moduleId is the immutable technical id defined in lib/data.ts (DOMAINS[].mods[].id) —
// this table is only ever created/updated by prisma/seed.ts + PUT /api/catalog, never a
// second row per id, never deleted (soft-delete via `active` to preserve history).
// This is the ONLY live source for module commercial data: lib/data.ts's DOMAINS array
// is used solely as (a) the seed default and (b) the engine's fallback default parameter —
// no other runtime code path may read module build/maint prices from it after seeding.
model CatalogModule {
  moduleId  String   @id
  name      String
  build     Float
  maint     Float
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Editable pack pricing (V1 scope: base price, maintenance). packKey is the immutable
// technical id defined in lib/data.ts (PACKS) — label and baseDays (delivery timing per
// mode) are engine/forcing rules and stay code-defined, never stored here. Same pattern
// and same guarantees as CatalogModule: only ever updated, never a second row, never
// deleted. The ONLY live source for pack base/maintenance; lib/data.ts's PACKS is used
// solely as (a) the seed default and (b) the engine's fallback default parameter.
model CatalogPack {
  packKey   String   @id
  base      Float
  maint     Float
  updatedAt DateTime @updatedAt
}

// Singleton row (id = "singleton") holding the confidential internal ROI parameters
model RoiSettings {
  id             String   @id @default("singleton")
  resourcePool   Float
  structureCost  Float
  directionCost  Float
  externalCosts  Float
  licenseCosts   Float
  otherCosts     Float
  minMarkup      Float
  allocationMode String
  productiveDays Int
  updatedAt      DateTime @updatedAt
}
